<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        CVE-2023-36415: Fixed in azure-identity 1.10.2 (Java). We use 1.18.3.
        Known OWASP false positive: scanner incorrectly matches the Java version range
        against the Python version range in NVD CPE data.
        https://github.com/jeremylong/DependencyCheck/issues/7245
    -->
    <suppress>
        <notes>False positive: CVE-2023-36415 is fixed in azure-identity >= 1.10.2 for Java. We use 1.18.3.</notes>
        <packageUrl regex="true">^pkg:maven/com\.azure/azure-identity@.*$</packageUrl>
        <cve>CVE-2023-36415</cve>
    </suppress>

    <!--
        CVE-2024-35255: Fixed in azure-identity 1.12.2 and msal4j 1.15.1 (Java).
        We use azure-identity 1.18.3 and msal4j 1.23.1, both of which are patched.
    -->
    <suppress>
        <notes>False positive: CVE-2024-35255 is fixed in azure-identity >= 1.12.2. We use 1.18.3.</notes>
        <packageUrl regex="true">^pkg:maven/com\.azure/azure-identity@.*$</packageUrl>
        <cve>CVE-2024-35255</cve>
    </suppress>
    <suppress>
        <notes>False positive: CVE-2024-35255 is fixed in msal4j >= 1.15.1. We use 1.23.1.</notes>
        <packageUrl regex="true">^pkg:maven/com\.microsoft\.azure/msal4j@.*$</packageUrl>
        <cve>CVE-2024-35255</cve>
    </suppress>

    <!--
        CVE-2025-7962: SMTP injection vulnerability in org.eclipse.angus:smtp (angus-mail).
        This CVE is incorrectly reported against angus-activation, which is a separate artifact
        with no SMTP or mail handling code.
        https://github.com/dependency-check/DependencyCheck/issues/8144
    -->
    <suppress>
        <notes>False positive: CVE-2025-7962 affects angus-mail/smtp, not angus-activation.</notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus-activation@.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>

    <!--
        CVE-2025-68161: TLS hostname verification flaw in log4j-core's Socket Appender.
        This CVE only affects log4j-core. We only have log4j-api on the classpath,
        which contains no socket, SSL, or appender logic.
    -->
    <suppress>
        <notes>False positive: CVE-2025-68161 only affects log4j-core Socket Appender. We only use log4j-api.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
        <cve>CVE-2025-68161</cve>
    </suppress>

    <!--
        CVE-2023-4218: Vulnerability in Eclipse IDE (the desktop application).
        This CVE is incorrectly matched against the Eclipse EMF library (org.eclipse.emf)
        due to imprecise CPE matching. The EMF library is a model framework with no relation
        to the IDE-level file handling vulnerability described in the CVE.
    -->
    <suppress>
        <notes>False positive: CVE-2023-4218 affects Eclipse IDE, not the Eclipse EMF library.</notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.emf/.*$</packageUrl>
        <cve>CVE-2023-4218</cve>
    </suppress>

    <!--
        CVE-2025-15104: SSRF vulnerability in Nu Html Checker (validator.nu).
        This CVE is incorrectly matched against hibernate-validator due to a CPE mismatch
        on the word "validator". The two projects are completely unrelated.
    -->
    <suppress>
        <notes>False positive: CVE-2025-15104 affects Nu Html Checker (validator.nu), not hibernate-validator.</notes>
        <packageUrl regex="true">^pkg:maven/org\.hibernate\.validator/hibernate-validator@.*$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>

    <!--
        CVE-2026-23907: Path traversal in Apache PDFBox's ExtractEmbeddedFiles example code (CVSS 5.3).
        The CVE is incorrectly matched against pdfbox-io, which is an IO utility module containing only
        stream handling utilities. The vulnerable ExtractEmbeddedFiles example and PDComplexFileSpecification
        class live in the main pdfbox artifact, not in pdfbox-io. We pull in pdfbox-io only transitively
        via fop -> fontbox and do not use any PDFBox example code in production.
    -->
    <suppress>
        <notes>False positive: CVE-2026-23907 affects the ExtractEmbeddedFiles example in the main pdfbox artifact, not pdfbox-io.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.pdfbox/pdfbox-io@.*$</packageUrl>
        <cve>CVE-2026-23907</cve>
    </suppress>

    <!--
        CVE-2026-33929: follow-up to CVE-2026-23907 — the path traversal fix shipped in PDFBox
        2.0.36/3.0.7 for the ExtractEmbeddedFiles example was itself incomplete (didn't account
        for path separators). Same reasoning as above still applies: this is example code in the
        main pdfbox artifact, not pdfbox-io, and we don't use PDFBox's example code in production.
    -->
    <suppress>
        <notes>False positive: CVE-2026-33929 affects the ExtractEmbeddedFiles example in the main pdfbox artifact, not pdfbox-io.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.pdfbox/pdfbox-io@.*$</packageUrl>
        <cve>CVE-2026-33929</cve>
    </suppress>

    <!--
        CVE-2026-33117: Authentication bypass in Azure SDK (azure-identity/azure-core).
        This CVE is incorrectly matched against azure-json via an overly broad NVD CPE
        pattern (microsoft:azure_sdk_for_java). The azure-json library contains only JSON
        serialization code — no authentication logic. 1.5.1 is the latest GA release;
        no fix version exists because the library is not affected.
    -->
    <suppress>
        <notes>False positive: CVE-2026-33117 is an auth bypass in azure-identity/azure-core. azure-json has no authentication code. 1.5.1 is the latest GA.</notes>
        <packageUrl regex="true">^pkg:maven/com\.azure/azure-json@.*$</packageUrl>
        <cve>CVE-2026-33117</cve>
    </suppress>

    <!--
        CVE-2026-33117 (continued): the same overly broad microsoft:azure_sdk_for_java CPE also
        matches azure-core, azure-core-http-netty, and azure-identity, but the actual vulnerable
        code is in the local cryptographic verification path of the Key Vault Keys library
        (com.azure:azure-security-keyvault-keys), fixed in 4.10.6. We do not depend on
        azure-security-keyvault-keys at all, so the vulnerable code path is not present.
    -->
    <suppress>
        <notes>Not exploitable: CVE-2026-33117 affects azure-security-keyvault-keys' local crypto verification, which we don't depend on.</notes>
        <packageUrl regex="true">^pkg:maven/com\.azure/(azure-core|azure-core-http-netty|azure-identity)@.*$</packageUrl>
        <cve>CVE-2026-33117</cve>
    </suppress>

    <!--
        CVE-2025-67721: Information leakage via buffer reuse in aircompressor's Snappy/LZ4 decompressors.
        aircompressor is pulled in transitively by GeoTools (gt-wms -> gt-coverage -> imageio-ext-tiff)
        for WMS/image rendering only. We do not decompress Snappy or LZ4 streams from external input,
        so the vulnerable code path is not reachable. No compatible fixed version exists for the 0.x
        series used by GeoTools 33.2.
    -->
    <suppress>
        <notes>Not exploitable: aircompressor is used only via GeoTools WMS rendering, not for Snappy/LZ4 decompression of external input.</notes>
        <packageUrl regex="true">^pkg:maven/io\.airlift/aircompressor@.*$</packageUrl>
        <cve>CVE-2025-67721</cve>
    </suppress>

    <!--
        CVE-2022-0839: XXE vulnerability in liquibase-core prior to 4.8.0.
        This CVE is incorrectly matched against spring-boot-liquibase, which is Spring Boot 4.1's
        autoconfiguration glue module for wiring up Liquibase — it contains no XML parsing code of
        its own. The actual liquibase-core version resolved via Spring Boot's dependency management
        is 5.0.3, far past the 4.8.0 fix.
    -->
    <suppress>
        <notes>False positive: CVE-2022-0839 affects liquibase-core &lt; 4.8.0. spring-boot-liquibase is just Boot's autoconfiguration glue; the actual liquibase-core resolved is 5.0.3.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring-boot-liquibase@.*$</packageUrl>
        <cve>CVE-2022-0839</cve>
    </suppress>

    <!--
        CVE-2026-54515: jackson-databind bug where @JsonFormat(with = ACCEPT_CASE_INSENSITIVE_PROPERTIES)
        can undo an unrelated @JsonIgnoreProperties exclusion. Fixed in 2.18.9, 2.21.5, and 3.1.4 — none
        of which are compatible drop-in replacements for the 2.21.4 that Spring Boot 4.1.0 manages
        (2.21.5 for the 2.x line hasn't been published yet as of this scan). Not exploitable regardless:
        we don't use ACCEPT_CASE_INSENSITIVE_PROPERTIES anywhere in the codebase.
    -->
    <suppress>
        <notes>Not exploitable: requires @JsonFormat ACCEPT_CASE_INSENSITIVE_PROPERTIES, which we don't use anywhere. No 2.21.x fix released yet.</notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson-databind@.*$</packageUrl>
        <cve>CVE-2026-54515</cve>
    </suppress>

    <!--
        CVE-2026-53914: unsafe deserialization in the Kotlin compiler/build-tools' build cache
        metadata handling. NVD's jetbrains:kotlin CPE matches the whole org.jetbrains.kotlin group,
        including kotlin-stdlib (a pure runtime API library with no build-cache code) and every
        kotlin-compiler-embeddable/kotlin-daemon-*/abi-tools build-tooling jar that only ever runs
        during our own trusted local/CI builds — none of them ship in the deployed application.
        The vulnerable path also requires a shared/remote Gradle build cache that an attacker could
        poison; this project doesn't configure one (see settings.gradle.kts).
    -->
    <suppress>
        <notes>Not exploitable: requires a poisoned remote build cache, which we don't use; these are build-time-only compiler jars, not shipped in the app.</notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/.*$</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>

    <!--
        DOMPurify (bundled inside springdoc's swagger-ui webjar) CVEs/advisories requiring
        DOMPurify >= 3.4.0 (and later >= 3.4.7-plus for a couple of them). springdoc-openapi 3.0.3
        (latest) still bundles swagger-ui 5.32.2, which vendors DOMPurify 3.3.2. Forcing a newer
        swagger-ui webjar version independently of springdoc breaks Swagger UI's static resource
        resolution (springdoc resolves swagger-ui's resource path by its own bundled version), so
        there's no clean fix until springdoc bumps its managed swagger-ui version. Risk is low:
        Swagger UI is a dev-only tool and every one of these requires a user to be tricked into
        interacting with attacker-controlled content while using it.
    -->
    <suppress>
        <notes>No fix available without breaking Swagger UI: springdoc 3.0.3 still bundles swagger-ui 5.32.2 / DOMPurify 3.3.2. Swagger UI is dev/test only.</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <cve>CVE-2026-41240</cve>
        <cve>CVE-2026-41238</cve>
        <cve>CVE-2026-41239</cve>
        <cve>CVE-2026-49458</cve>
        <cve>CVE-2026-49459</cve>
        <cve>CVE-2026-49978</cve>
        <vulnerabilityName>DOMPurify has a logic inconsistency where FORBID_TAGS is not checked when a function-based ADD_TAGS (tagCheck) returns true. Due to short-circuit evaluation, the FORBID_TAGS check is never evaluated, allowing explicitly forbidden elements to pass through sanitization when EXTRA_ELEMENT_HANDLING.tagCheck is configured.</vulnerabilityName>
        <vulnerabilityName>DOMPurify: Hook mutation of `data.allowedTags` / `data.allowedAttributes` permanently pollutes `DEFAULT_ALLOWED_TAGS` / `DEFAULT_ALLOWED_ATTR`</vulnerabilityName>
        <vulnerabilityName>DOMPurify: Permanent `ALLOWED_ATTR` pollution via `setConfig()` bypassing the hook clone-guard (incomplete fix of the 3.4.7 hook-pollution patch)</vulnerabilityName>
        <vulnerabilityName>DOMPurify: SAFE_FOR_TEMPLATES bypass - template expressions survive sanitization inside &lt;template&gt; content when using DOM output modes</vulnerabilityName>
        <vulnerabilityName>DOMPurify: Trusted Types policy survives `clearConfig()` and can poison later `RETURN_TRUSTED_TYPE` output</vulnerabilityName>
        <vulnerabilityName>DOMPurify: `IN_PLACE` mode trusts attacker-controlled `nodeName` on live non-form nodes, allowing script retention and XSS via attacker-supplied DOM objects</vulnerabilityName>
    </suppress>

</suppressions>
